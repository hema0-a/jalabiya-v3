rules_version = '2';

// قواعد Firestore لتطبيق ورشة الجلابيب — كل مستخدم يصل لبياناته فقط.
// المسار الذي يستخدمه التطبيق: users_v3/{uid}/data/{main | store_<المخزن>_<رقم>}
// طريقة التطبيق: Firebase Console → Firestore Database → Rules → الصق المحتوى → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users_v3/{uid}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // أي مسار آخر مرفوض
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
