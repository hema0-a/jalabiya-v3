{
  "name": "jalabiya-v3",
  "version": "3.3.43",
  "private": true,
  "description": "ورشة تفصيل الجلابيب — PWA",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "dev": "node scripts/serve.cjs",
    "dev:mobile": "node scripts/serve.cjs --host",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check:consistency": "node scripts/check-consistency.cjs",
    "check:static": "npm run check:syntax && npm run check:consistency",
    "test:browser": "node scripts/ci-check.cjs",
    "check": "npm run check:static && npm run test:browser",
    "bump": "node scripts/bump-version.cjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
